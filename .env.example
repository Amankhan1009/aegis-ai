# --- Core ---
APP_ENV=local
APP_NAME=enterprise-ai-ops
API_PORT=8000
LOG_LEVEL=INFO

# --- AI (never commit real keys; copy to .env) ---
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Persistence ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_ops
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# --- Streamlit Dashboard ---
STREAMLIT_API_URL=http://localhost:8000
